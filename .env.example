# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Security / JWT
JWT_SECRET=super-secret-jwt-key-change-this-in-production-min32chars
JWT_EXPIRES_IN=7d

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=task_manager_db
DB_CONNECTION_LIMIT=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
